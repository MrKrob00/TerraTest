extends Resource
class_name BiomePropSet
# Набор пропов ОДНОГО биома для BiomeScatter. Художник просто заполняет это в инспекторе:
# выбирает биом, кидает свои сцены/меши в scenes, ставит count/масштаб — и всё.

## В каком биоме ставить. «Любой» — везде (кроме крутых склонов).
@export_enum("Любой:0", "Песок:1", "Трава:2", "Каньон:3", "Снег:4") var biome: int = 3
## Сцены-пропы художника (.tscn или .glb). Для каждого экземпляра берётся случайная из списка.
@export var scenes: Array[PackedScene] = []
## Сколько экземпляров раскидать по всей карте (рендерятся только ближние — стриминг).
@export var count: int = 400
@export var min_scale: float = 0.8
@export var max_scale: float = 1.5
## Случайный поворот вокруг вертикали (чтобы не были одинаково повёрнуты).
@export var random_yaw: bool = true
## Сдвиг по высоте (утопить/приподнять относительно земли).
@export var y_offset: float = 0.0
## Мин. дистанция между экземплярами этого набора (не налезать).
@export var min_spacing: float = 3.0
