; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Terratest"
run/main_scene="res://node_3d.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
config/specular_occlusion/enabled=true
config/reflection_atlas/reflection_size=256

[display]

; Весь 2D/HUD рисуется в базовом разрешении 1152×648 и МАСШТАБИРУЕТСЯ под реальный
; экран (canvas_items) — кнопки/джойстики/панели растут-уменьшаются вместе с окном,
; а не остаются в пикселях. expand = заполнять экран (без чёрных полос), лишнее по
; широкой стороне добавляется по краям (угловые элементы HUD в hud.gd пере-раскладываются
; на size_changed).
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[autoload]

G="*res://G.gd"
Dialogue="*res://dialogue.tscn"
Music="*res://music_manager.gd"
Q="*res://quest_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/LiteTerrain/plugin.cfg")

[input]

Take={
"deadzone": 0.2,
"events": []
}
TakeOff={
"deadzone": 0.2,
"events": []
}
Attack={
"deadzone": 0.2,
"events": []
}
Movement={
"deadzone": 0.2,
"events": []
}
Building={
"deadzone": 0.2,
"events": []
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="blocks"
3d_physics/layer_3="ResourceNodes"
3d_physics/layer_4="resources"
3d_physics/layer_5="machine"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/use_physical_light_units=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
shading/overrides/force_vertex_shading=true
textures/default_filters/use_nearest_mipmap_filter=true
scaling_3d/scale=0.75
environment/glow/upscale_mode=0
occlusion_culling/use_occlusion_culling=true
