# Godot 4+ specific ignores
.godot/
/android/
/export/
addons/terrain_sculpt/terrain_mesh2.res

# Музыка: сами треки НЕ в гите (тяжёлые, ~21МБ) — держи их локально, кидай в папки
# music/{travel,battle,menu}/. Структура папок (.gitkeep) и README остаются в репо.
music/**/*.ogg
music/**/*.mp3
music/**/*.wav
music/**/*.ogg.import
music/**/*.mp3.import
music/**/*.wav.import

# 3D-модели .glb в гит не грузим. ВНИМАНИЕ: .glb — ИСХОДНИКИ мешей, импорт идёт в
# игнорируемый .godot/imported/. На них ссылаются сцены блоков — держи .glb ЛОКАЛЬНО,
# иначе на свежем клоне блоки не загрузятся. .import (текстовые) остаются в репо.
*.glb
