shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_add;

// КУПОЛ ЩИТА ИЗ ШЕСТИУГОЛЬНЫХ ПЛАСТИН.
//
// Был однотонный полупрозрачный шар на 12% альфы: он не читался ни как щит, ни как что-либо
// вообще — просто голубоватое пятно вокруг машины. Пластины дают ему устройство: видно, что это
// собранная оболочка, а не заливка.
//
// СЕТКА СЧИТАЕТСЯ ПО UV СФЕРЫ, а не по мировым координатам. По миру купол «проезжал» бы сквозь
// собственный узор, когда машина едет, и узор жил бы отдельно от щита. По UV он приклеен к
// куполу и едет с ним.
//
// ШАГ ПО ГОРИЗОНТАЛИ ВЫРАВНИВАЕТСЯ НА sin: у сферы линии долготы сходятся к полюсам, и ровная
// сетка в UV дала бы на макушке иглы вместо шестиугольников. Умножение частоты на синус широты
// держит клетку примерно одного размера по всей сфере.
//
// КРАЙ ЯРЧЕ СЕРЕДИНЫ (френель). Без этого шар выглядит налитым; со свечением по касательной он
// читается как ОБОЛОЧКА, сквозь которую видно машину.

uniform vec3  tint : source_color = vec3(0.35, 0.72, 1.0);
uniform float cells = 14.0;                       // пластин по высоте купола
uniform float line_w : hint_range(0.01, 0.4) = 0.08;   // толщина шва между пластинами
uniform float fill : hint_range(0.0, 1.0) = 0.10;      // заливка самой пластины
uniform float rim_pow : hint_range(0.5, 8.0) = 2.6;    // насколько резко разгорается край
uniform float rim_gain : hint_range(0.0, 4.0) = 1.6;
uniform float flicker_speed = 1.7;
uniform float energy : hint_range(0.0, 1.0) = 1.0;     // заряд: гаснет вместе со щитом
uniform vec3  glitch_a : source_color = vec3(0.15, 0.85, 1.0);   // тот же циан, что у карточек
uniform vec3  glitch_b : source_color = vec3(0.72, 0.16, 1.0);   // и та же маджента
uniform float glitch_share : hint_range(0.0, 0.6) = 0.10;        // доля пластин в глитче
uniform float glitch_rate = 6.0;                                  // как часто перещёлкиваются
uniform float hit : hint_range(0.0, 1.0) = 0.0;   // свежее попадание: купол вспыхивает целиком

float hash(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}

// Расстояние до ближайшего ребра шестиугольника и координата его центра.
// Классическая укладка: две решётки со смещением, ближайший центр и есть клетка.
vec3 hex_cell(vec2 p) {
	vec2 s = vec2(1.0, 1.7320508);            // 1 и sqrt(3): пропорции шестиугольной решётки
	vec2 a = mod(p, s) - s * 0.5;
	vec2 b = mod(p - s * 0.5, s) - s * 0.5;
	vec2 g = dot(a, a) < dot(b, b) ? a : b;
	vec2 id = p - g;
	// Расстояние до ребра: максимум проекций на три оси решётки.
	float d = max(abs(g.x) * 0.8660254 + g.y * 0.5, g.y);
	return vec3(d, id);
}

void fragment() {
	// Широта: 0 на полюсе, 1 на экваторе. Ею выравниваем горизонтальный шаг.
	float lat = max(sin(UV.y * 3.14159265), 0.08);
	vec2 p = vec2(UV.x * cells * lat * 2.0, UV.y * cells);
	vec3 h = hex_cell(p);

	// Шов между пластинами — яркая линия, сама пластина почти прозрачна.
	float edge = smoothstep(0.5 - line_w, 0.5, h.x);
	// Пластины слегка разной яркости и медленно перемигиваются: щит работает, а не нарисован.
	float n = hash(h.yz);
	float pulse = 0.75 + 0.25 * sin(TIME * flicker_speed + n * 6.2831);

	float fres = pow(1.0 - clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0), rim_pow);

	float a = (fill * (0.6 + 0.4 * n) + edge) * pulse;
	a = (a + fres * rim_gain) * energy;
	a += hit * 0.5;

	// ПЛАСТИНЫ ГЛИТЧАТ, А НЕ ПРОСТО СВЕТЯТСЯ. Шестиугольники сами по себе оставляли купол
	// шаром — «красивее, но всё тот же шар». Здесь редкие пластины перещёлкиваются в цвета
	// глитча (циан/маджента), теми же, которыми говорит появление блока: щит читается как
	// работающая система, а не как крашеная сфера.
	//
	// Редко и вразнобой: зажечь все — снова заливка, от которой и уходили.
	float gt = floor(TIME * glitch_rate);
	float gsel = hash(h.yz + vec2(gt, gt * 1.7));
	float on = step(1.0 - glitch_share, gsel);
	vec3 gcol = gsel < (1.0 - glitch_share * 0.5) ? glitch_a : glitch_b;
	vec3 col = mix(tint, gcol, on);

	ALBEDO   = col;
	EMISSION = col * (edge * 1.4 + fres * rim_gain + on * 1.6) * energy;
	ALPHA    = clamp(a + on * 0.35 * energy, 0.0, 1.0);
}
