shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_add;

// ЩИТ: РЕШЁТКА ШЕСТИУГОЛЬНЫХ ПЛАСТИН НА СФЕРЕ.
//
// Прошлая версия считала сетку ПО UV СФЕРЫ с поправкой на широту. На картинке это дало не
// шестиугольники, а спирали: линии долготы сходятся к полюсам, и поправка синусом их не
// выпрямляет, а закручивает. Сверху и сбоку купол читался как молочный шар с разводами.
//
// СЕТКА СЧИТАЕТСЯ ОТ НАПРАВЛЕНИЯ, А НЕ ОТ UV. Направление из центра раскладывается на грань
// куба (какая ось больше по модулю), внутри грани — обычная плоская шестиугольная решётка.
// У куба нет полюса, поэтому сходиться нечему. Швы остаются на двенадцати рёбрах куба, и это
// цена: бесшовной шестиугольной сетки на сфере не существует вовсе — нужны двенадцать
// пятиугольников, как на футбольном мяче.
//
// РАВНОУГОЛЬНАЯ ПОПРАВКА (atan). Прямая проекция на грань растягивает клетку к углу грани
// почти вдвое; арктангенс делает шаг равномерным по углу, и пластины получаются одного
// размера по всему куполу.
//
// ЧТО СВЕТИТСЯ: шов между пластинами и точки на стыках трёх пластин, плюс кольцо по
// касательной. Заливка пластины почти нулевая — купол обязан оставаться ПРОЗРАЧНЫМ, сквозь
// него видно машину. Прошлый купол светился заливкой и краем сразу и в сумме с аддитивным
// смешением выбеливался в белый шар.
//
// ЗАДНЯЯ ПОЛУСФЕРА ПРИГЛУШЕНА. cull_disabled нужен (камера заезжает внутрь купола), но при
// аддитивном смешении дальняя решётка складывалась с ближней, и плотность узора удваивалась.

uniform vec3  tint : source_color = vec3(0.30, 0.66, 1.0);
uniform float cells = 2.2;                              // пластин на половину грани куба
uniform float line_w : hint_range(0.01, 0.30) = 0.045;  // толщина шва
uniform float fill : hint_range(0.0, 0.3) = 0.04;       // заливка пластины
uniform float rim_pow : hint_range(1.0, 12.0) = 5.0;    // резкость кольца по касательной
uniform float rim_gain : hint_range(0.0, 3.0) = 1.1;
uniform float halo_pow : hint_range(0.5, 6.0) = 1.8;    // широкое мягкое свечение под кольцом
uniform float halo_gain : hint_range(0.0, 2.0) = 0.22;
uniform float back_mul : hint_range(0.0, 1.0) = 0.18;   // вклад дальней полусферы
// ЗАРЯД РЕШАЕТ, СКОЛЬКО ПЛАСТИН СТОИТ, а не насколько купол бледный. Бледнеющий купол читался
// как «эффект гаснет»; осыпающаяся решётка читается как «щита осталось на столько-то».
// Порядок пластин постоянный (хеш по клетке), поэтому при разряде гаснут те же самые, а не
// перетасовываются каждый кадр — то же правило, что у клеток урона на броне.
uniform float energy : hint_range(0.0, 1.0) = 1.0;
// Свежее попадание: 1 в момент удара, едет к нулю. От точки удара расходится волна, и только
// по ней пластины глитчат. Раньше доля пластин глитчала ВСЕГДА, и щит рябил, когда по нему
// никто не стрелял.
uniform float hit : hint_range(0.0, 1.0) = 0.0;
uniform vec3  hit_dir = vec3(0.0, 1.0, 0.0);            // направление удара в локальных осях
uniform float glitch_rate = 18.0;
uniform vec3  glitch_a : source_color = vec3(0.15, 0.85, 1.0);
uniform vec3  glitch_b : source_color = vec3(0.72, 0.16, 1.0);

varying vec3 v_dir;

const float PI_ = 3.14159265;

float hash(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}

// Грань куба + равноугольные координаты внутри неё. face различает и противоположные грани,
// иначе узор на передней и задней половине был бы зеркально одинаковым.
vec2 face_uv(vec3 n, out float face) {
	vec3 a = abs(n);
	vec2 uv;
	if (a.x >= a.y && a.x >= a.z) {
		uv = vec2(n.z, n.y) / a.x;
		face = n.x < 0.0 ? 1.0 : 0.0;
	} else if (a.y >= a.z) {
		uv = vec2(n.x, n.z) / a.y;
		face = n.y < 0.0 ? 3.0 : 2.0;
	} else {
		uv = vec2(n.x, n.y) / a.z;
		face = n.z < 0.0 ? 5.0 : 4.0;
	}
	return atan(uv) * (4.0 / PI_);
}

// Шестиугольник: расстояние до ребра, номер клетки и близость к углу (стыку трёх пластин).
// Две решётки со смещением, ближайший центр и есть клетка.
vec4 hex(vec2 p) {
	// ШАГ РЕШЁТКИ И МЕТРИКА ОБЯЗАНЫ БЫТЬ ОДНОЙ ОРИЕНТАЦИИ. Здесь годами стояло (1, 1.732) при
	// метрике max(0.866·|x| + 0.5·|y|, |y|), то есть шаг от одной укладки, а расстояние от
	// перевёрнутой. Шестиугольников такая пара не даёт вообще — проверено численно, выходит
	// рваный узор из дуг, который на сфере и читался как «закрученные линии».
	vec2 s = vec2(1.7320508, 1.0);
	vec2 a = mod(p, s) - s * 0.5;
	vec2 b = mod(p - s * 0.5, s) - s * 0.5;
	vec2 g = dot(a, a) < dot(b, b) ? a : b;
	vec2 id = p - g;
	vec2 q = abs(g);
	float e0 = dot(q, vec2(0.8660254, 0.5));
	float e1 = q.y;
	return vec4(max(e0, e1), id.x, id.y, abs(e0 - e1));
}

void vertex() {
	v_dir = normalize(VERTEX);
}

void fragment() {
	vec3 n = normalize(v_dir);
	float face;
	vec2 p = face_uv(n, face) * cells;
	vec4 h = hex(p);
	vec2 id = vec2(h.y, h.z) + vec2(face * 41.0, face * 17.0);

	// Стоит ли эта пластина. Немного пластин держится даже на остатках заряда: пустая
	// решётка с одним кольцом неотличима от выключенного щита, а он ещё работает.
	float up = step(hash(id), clamp(energy * 0.95 + 0.12, 0.0, 1.0));

	float seam = smoothstep(0.5 - line_w, 0.5, h.x);
	float body = 1.0 - seam;
	float corner = smoothstep(0.10, 0.0, h.w) * smoothstep(0.5 - line_w * 2.0, 0.5, h.x);

	float ndv = 1.0 - clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	float rim = pow(ndv, rim_pow) * rim_gain + pow(ndv, halo_pow) * halo_gain;

	float lattice = (seam + corner * 1.1 + body * fill) * up;

	// Ветка по ЮНИФОРМУ: пока по щиту не попали, весь этот блок не считается ни на одном
	// пикселе. Это и дешевле прошлого варианта, где хеш глитча крутился постоянно.
	vec3 col = tint;
	float flare = 0.0;
	if (hit > 0.001) {
		float ang = acos(clamp(dot(n, normalize(hit_dir)), -1.0, 1.0));
		// Два слоя: вспышка В ТОЧКЕ удара, которая гаснет быстрее всего, и волна, уходящая от
		// неё. Одна волна без точки читается как кольцо ниоткуда — не видно, куда прилетело.
		float core = smoothstep(0.55, 0.0, ang) * hit * hit * 0.8;
		float wave = (1.0 - hit) * 1.7;
		float ring = smoothstep(0.45, 0.05, abs(ang - wave)) * hit;
		flare = core + ring;
		float gt = floor(TIME * glitch_rate);
		float gsel = hash(id + vec2(gt, gt * 1.7));
		float on = step(1.0 - 0.7 * clamp(flare, 0.0, 1.0), gsel) * up;
		// Цвет берётся ОТДЕЛЬНЫМ хешем. С тем же, которым отбирали пластины, выбор был
		// предрешён: отбор оставляет только большие значения, а они все лежат выше 0.5.
		float pick = hash(id + vec2(gt * 3.3, 11.0));
		col = mix(tint, pick < 0.5 ? glitch_a : glitch_b, on);
		flare += on * 0.9;
	}

	float side = FRONT_FACING ? 1.0 : back_mul;
	ALBEDO   = col;
	EMISSION = col * (lattice * 0.8 + rim * 0.7 + flare * 1.3) * side;
	ALPHA    = clamp((lattice + rim + flare) * side, 0.0, 1.0);
}
