shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, depth_test_disabled;

// ГЛИТЧ СПАВНА МАШИНЫ — ЭКРАН МЕЖДУ КАМЕРОЙ И МАШИНОЙ, А НЕ ОБОЛОЧКА ВОКРУГ НЕЁ.
//
// Прошлая попытка была оболочкой на каждый блок, и она провалилась дважды: по отдельности блоки
// давали сорок независимых фронтов, а на чанках тот же приём читался как поломка рендера. Здесь
// другое устройство: ОДИН билборд, который закрывает машину со стороны взгляда. Игрок видит не
// машину в глитчах, а глитч НА МЕСТЕ машины, который расступается и открывает её.
//
// РАСХОДИТСЯ ОТ КРАЁВ К ЦЕНТРУ. Клетка у края гаснет почти сразу, в середине — последней. Значит
// машина проявляется силуэтом изнутри наружу... нет, наоборот: сначала видно её края, и последней
// открывается середина. Так читается «собралось», а не «растворилось».
//
// БИЛБОРД, ПОЭТОМУ КАМЕРА МОЖЕТ ЕХАТЬ. Квад разворачивается к камере каждый кадр, то есть
// остаётся между ней и машиной, откуда бы ни смотрели. Без этого облёт во время спавна показал бы
// эффект с ребра, то есть ничего.
//
// Глубина ОТКЛЮЧЕНА (depth_test_disabled): квад обязан закрывать машину, даже если геометрия
// машины оказалась ближе к камере, чем его плоскость.

uniform float progress : hint_range(0.0, 1.0) = 0.0;
uniform float cells = 26.0;                       // клеток по стороне квада
uniform float seed = 0.0;
uniform vec3  col_a : source_color = vec3(0.15, 0.85, 1.00);   // циан — как у глитч-карточек
uniform vec3  col_b : source_color = vec3(0.85, 0.15, 0.95);   // и маджента
uniform float flicker = 14.0;

float h(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}

void vertex() {
	// Настоящий билборд: берём оси камеры и масштабируем их размером квада. Позиция — из модели.
	mat4 m = MODEL_MATRIX;
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
			INV_VIEW_MATRIX[0] * length(m[0].xyz),
			INV_VIEW_MATRIX[1] * length(m[1].xyz),
			INV_VIEW_MATRIX[2] * length(m[2].xyz),
			m[3]);
}

void fragment() {
	vec2 uv = UV - vec2(0.5);
	// КРУГ, А НЕ КВАДРАТ: у квадрата углы торчали бы за силуэт машины и эффект читался бы
	// прямоугольной заплаткой на экране.
	float d = clamp(length(uv) * 2.0, 0.0, 1.0);
	if (d > 1.0) {
		discard;
	}
	vec2 cell = floor(UV * cells);
	// Порог клетки: у края (d→1) он около нуля, в центре — около единицы. Значит край уходит
	// первым. Хеш подмешан, чтобы граница не была чистой окружностью — ровный круг выглядит
	// как дырка, а не как расступающиеся данные.
	float thr = (1.0 - d) * 0.82 + h(cell + vec2(seed, seed * 1.7)) * 0.22;
	if (progress > thr) {
		discard;                      // клетка ушла — здесь видно машину
	}
	float n = h(cell + vec2(floor(TIME * flicker) * 1.3, seed));
	vec3 c = n < 0.5 ? col_a : col_b;
	// Часть клеток тёмные: сплошная заливка цветом читается как залитый экран, а не как данные.
	if (n > 0.86) {
		c = vec3(0.02, 0.02, 0.05);
	}
	// Кромка у самой границы ухода — ярче: видно, ГДЕ сейчас идёт край.
	float edge = smoothstep(0.10, 0.0, thr - progress);
	ALBEDO   = c;
	EMISSION = c * (0.6 + edge * 2.2);
	ALPHA    = 1.0;
}
